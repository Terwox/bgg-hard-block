{
  "manifest_version": 3,
  "name": "BGG Hard Block",
  "version": "0.1.0",
  "description": "Removes blocked BoardGameGeek forum posts and quotations before they can flash onscreen.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "BGG Hard Block",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://boardgamegeek.com/forum/*",
        "*://boardgamegeek.com/forums*",
        "*://boardgamegeek.com/thread/*",
        "*://boardgamegeek.com/threads/*",
        "*://www.boardgamegeek.com/forum/*",
        "*://www.boardgamegeek.com/forums*",
        "*://www.boardgamegeek.com/thread/*",
        "*://www.boardgamegeek.com/threads/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://boardgamegeek.com/forum/*",
        "*://boardgamegeek.com/forums*",
        "*://boardgamegeek.com/thread/*",
        "*://boardgamegeek.com/threads/*",
        "*://www.boardgamegeek.com/forum/*",
        "*://www.boardgamegeek.com/forums*",
        "*://www.boardgamegeek.com/thread/*",
        "*://www.boardgamegeek.com/threads/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/content-core.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
